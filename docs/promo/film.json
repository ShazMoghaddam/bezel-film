      "id": "private",
      "type": "custom",
      "file": "scenes/private.js",
      "props": {
        "heading": "Private by design",
        "items": [
          {
            "text": "Runs offline",
            "line": 1
          },
          {
            "text": "No accounts",
            "line": 2
          },
          {
            "text": "No API keys",
            "line": 2,
            "offset": 0.8
          },
          {
            "text": "Nothing leaves your computer",
            "line": 2,
            "offset": 1.6
          }
        ]
