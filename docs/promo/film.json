    {
      "id": "formats",
      "type": "custom",
      "file": "scenes/formats.js",
      "props": {
        "heading": "One film, every shape",
        "labels": [
          "TikTok · Reels · Shorts",
          "LinkedIn · Instagram",
          "YouTube · X"
        ],
        "note": "Text kept clear of each app's buttons, and a cover image for every version"
      },
      "narration": "One film, every shape. Tall for TikTok, Reels and Shorts. Four by five for LinkedIn and Instagram. Wide for YouTube and X. The words stay clear of each app's buttons, and every version gets a cover image.",
