        {
          "line": 1,
          "at": 0.1,
          "sound": "pop",
          "gain": 0.35
        },
        {
          "line": 2,
          "at": 0.1,
          "sound": "pop",
          "gain": 0.35
        },
        {
          "line": 3,
          "at": 0.1,
          "sound": "pop",
          "gain": 0.35
        }
      ]
    },
    {
      "id": "sound",
      "type": "custom",
      "file": "scenes/sound.js",
      "props": {
        "heading": "Every film comes with sound",
        "items": [
          {
            "name": "Voice",
            "note": "Female or male, made on your computer"
          },
          {
            "name": "Music",
            "note": "Six moods, dipping under the voice"
          },
          {
            "name": "Captions",
            "note": "So it works on mute"
          },
          {
            "name": "Sound effects",
            "note": "Landing with the movement"
          }
        ]
      },
      "narration": "Every film comes with sound. A natural voiceover, female or male. Music for six moods, dipping whenever the voice speaks. Captions, so it works on mute. And sound effects that land with the movement.",
      "sounds": [
        {
          "line": 4,
          "at": 0.9,
          "sound": "pop",
          "gain": 0.4
        },
        {
          "line": 4,
          "at": 1.3,
          "sound": "ding",
          "gain": 0.35
        }
      ]
    },
    {
      "id": "agents",
      "type": "custom",
      "file": "scenes/agents.js",
      "props": {
        "heading": "Works with the agent you already use",
        "agents": [
          "Claude Code",
          "Codex",
          "Gemini CLI",
          "Cursor",
          "GitHub Copilot",
          "Windsurf",
          "AGENTS.md"
        ],
        "file": "scenes/reveal.js",
        "checks": [
          "Same picture for the same moment",
          "Words inside the safe area",
          "Readable contrast",
          "Draws quickly"
        ]
      },
      "narration": "It works with the coding agent you already use. Claude Code, Codex, Gemini CLI, Cursor, GitHub Copilot, Windsurf, and any agent that reads an agents file. Your agent writes each scene in code, and Bezel Film checks every one before it renders.",
      "sounds": [
        {
          "line": 1,
          "at": 0.1,
          "sound": "pop",
          "gain": 0.3,
          "for": 2
        },
        {
          "line": 2,
          "at": 1.2,
          "sound": "tick",
          "gain": 0.35,
          "for": 1.4
        }
      ]
    },
    {
      "id": "how",
      "type": "custom",
      "file": "scenes/how.js",
      "props": {
        "heading": "Three steps to your first film",
        "steps": [
          "Run one command in an empty folder",
          "Describe your film to your agent",
          "Watch it, then ask for changes"
        ],
        "note": "Needs Node.js 22 or later",
        "terminal": [
          {
            "step": 0,
            "text": "$ npx bezel-film init"
          },
          {
            "step": 0,
            "delay": 1.3,
            "text": "✓ Ready. Your welcome film is made.",
            "colour": "#3DDC97",
            "type": false
          },
          {
            "step": 1,
            "text": "> Make a one-minute film about our launch,",
            "colour": "#7C8CFF"
          },
          {
            "step": 1,
            "delay": 1.4,
            "text": "  in neon, with upbeat music.",
            "colour": "#7C8CFF"
          },
          {
            "step": 2,
            "text": "✓ films/launch/film.mp4",
            "colour": "#3DDC97",
            "type": false
          },
          {
            "step": 2,
            "delay": 1,
            "text": "> Make the title bigger.",
            "colour": "#7C8CFF"
          }
        ]
      },
      "narration": "Getting started takes three steps. Run one command in an empty folder. Describe your film to your agent, in plain words. Then watch it, and ask for changes.",
      "sounds": [
        {
          "line": 1,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.35
        },
        {
          "line": 2,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.35,
          "pitch": 2
        },
        {
          "line": 3,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.35,
          "pitch": 4
        }
      ]
    },
    {
      "id": "time",
      "type": "custom",
      "file": "scenes/time.js",
      "props": {
        "figures": [
          {
            "value": "230 MB",
            "label": "Downloaded once",
            "note": "The voice, a browser and the music",
            "line": 1
          },
          {
            "value": "Minutes",
            "label": "To make a one-minute film",
            "note": "Rendered on your own computer",
            "line": 2
          }
        ],
        "draft": {
          "label": "Already have a project? Draft a first film from it",
          "command": "npx bezel-film draft owner/repo",
          "line": 4
        }
      },
      "narration": "The first run downloads the voice, a browser and the music, once. About 230 megabytes. After that, a one-minute film takes a few minutes. Already have a project? Draft turns its README into a first film.",
      "sounds": [
        {
          "line": 1,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.4
        },
        {
          "line": 2,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.4
        }
      ]
    },
