{
  "$schema": "../../schema/film.schema.json",
  "spec": 1,
  "title": "Bezel Film: narrated films, made in code",
  "style": "dark-keynote",
  "voice": {
    "engine": "kokoro",
    "gender": "female"
  },
  "music": {
    "source": "generated",
    "mood": "epic"
  },
  "captions": true,
  "cover": {
    "scene": "reveal"
  },
  "scenes": [
    {
      "id": "hook",
      "type": "custom",
      "file": "scenes/hook.js",
      "props": {
        "lines": [
          "What if your coding agent could make films?",
          "Not clips.",
          "Proper narrated films, made in code."
        ]
      },
      "narration": "What if your coding agent could make films? Not clips. Proper, narrated films, made in code.",
      "sounds": [
        {
          "line": 0,
          "at": 0.1,
          "sound": "sweep",
          "gain": 0.35
        },
        {
          "line": 2,
          "at": 0.1,
          "sound": "tap",
          "gain": 0.4
        }
      ]
    },
    {
      "id": "reveal",
      "type": "custom",
      "file": "scenes/reveal.js",
      "props": {
        "line": "Describe an idea. Your agent makes the film.",
        "facts": "Free  ·  Open source  ·  On npm"
      },
      "narration": "Meet Bezel Film. You describe an idea, and your coding agent turns it into a finished film. It's free, open source, and on npm.",
