      "sounds": [{ "at": 1.2, "sound": "swish", "gain": 0.5 }, { "at": 3.2, "sound": "tick", "gain": 0.6 }]
    },
    {
      "id": "go",
      "type": "custom",
      "file": "scenes/go.js",
      "props": { "title": "Just five minutes.", "line": "Starting is the hardest part." },
      "narration": "Give it five minutes. Starting is the hardest part.",
      "sounds": [{ "at": 0.6, "sound": "pop", "gain": 0.5 }, { "at": 2.2, "sound": "ding", "gain": 0.4 }]
    }
  ]
