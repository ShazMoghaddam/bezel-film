{
  "$schema": "../../schema/film.schema.json",
  "spec": 1,
  "title": "Why we put things off",
  "style": "stick-figures",
  "format": { "aspect": "16:9", "resolution": "1080p", "fps": 30 },
  "voice": { "engine": "kokoro", "gender": "female" },
  "music": { "source": "generated", "mood": "upbeat" },
  "scenes": [
    {
      "id": "hook",
      "type": "custom",
      "file": "scenes/hook.js",
      "props": { "title": "Why do we put things off?", "task": "Write the report" },
      "narration": "Why do we put things off, even when we know we shouldn't?",
      "sounds": [{ "at": 2.4, "sound": "pop", "gain": 0.5 }]
    },
    {
      "id": "too-big",
      "type": "custom",
      "file": "scenes/too-big.js",
      "props": { "task": "THE REPORT", "label": "too big!" },
      "narration": "It's not that we're lazy. The task just feels too big to start.",
      "sounds": [{ "at": 1.0, "sound": "whoosh", "gain": 0.5 }]
    },
    {
      "id": "escape",
      "type": "custom",
      "file": "scenes/escape.js",
      "props": { "label": "easy win" },
      "narration": "So our brain grabs something easier, like one more scroll.",
      "sounds": [{ "at": 2.6, "sound": "ding", "gain": 0.4 }]
    },
    {
      "id": "shrink",
      "type": "custom",
      "file": "scenes/shrink.js",
      "props": { "steps": ["Outline", "Notes", "Draft", "Edit", "Send"], "title": "Shrink the first step" },
