{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec": {
      "type": "number",
      "const": 1,
      "description": "Version of the film spec format."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "style": {
      "type": "string",
      "enum": [
        "blueprint",
        "chalkboard",
        "crayon-book",
        "dark-keynote",
        "data-on-paper",
        "data-story",
        "isometric",
        "manga",
        "mid-century-cartoon",
        "neon",
        "origami",
        "paper-lantern",
        "pixel-game",
        "pop-art",
        "pop-up-book",
        "retro-terminal",
        "risograph",
        "rubber-hose-cartoon",
        "stick-figures",
        "swiss-poster",
        "watercolour",
        "whiteboard"
      ],
      "description": "The film's look. blueprint: Technical drawings plotted in white on blue paper: precise lines, measurements and labels in capitals. chalkboard: A lesson worked out in chalk on a dark green slate: written up line by line, with dust off the chalk and a felt eraser wiping the board between ideas. crayon-book: A picture book drawn in wax crayon on dark paper: scribbled colour, wobbly outlines that boil on twos, and soft watercolour washes. dark-keynote: A product launch on a black stage: the product's screens are the star, with big clean type and slow, confident moves. data-on-paper: A data journal on graph paper: charts drawn mark by mark in coloured pencil, hatched fills and handwritten notes. data-story: Clean, confident and chart-led. Big numbers, bold colour per series, springy motion. isometric: A small world seen from above at an angle: blocks rise, roads unroll and things move through it to show how it works. manga: A black-and-white comic page: panels open on the beat, with speed lines, screentone and big sound-effect lettering. mid-century-cartoon: Flat colour and simple geometric characters, with snappy pose-to-pose movement like classic limited animation. neon: Glass tubes that flicker on at night: glowing signs on a dark brick wall, humming colour and warm haze. origami: Folded paper that unfolds into each idea: flat-shaded facets, crisp creases and flaps that turn over as the story moves on. paper-lantern: Cut paper layers lit from behind at night: silhouettes in deep blues, warm glowing windows and a slow drift between the layers. pixel-game: A 90s video game: pixel-art sprites, chunky text boxes, menus and a level-up for every point you make. pop-art: Comic dots and bold outlines: flat primary colours, halftone shading, starbursts and speech bubbles that punch in. pop-up-book: A storybook spread where card scenes spring up off the page: thick paper cut-outs with white rims, soft shadows and pull tabs. retro-terminal: Glowing green text on an old monitor: commands typed in, logs scrolling, ASCII art and a blinking cursor. risograph: A zine printed one ink at a time: two or three bright inks that overlap into new colours, slightly out of register, with grain. rubber-hose-cartoon: Black-and-white characters with bendy limbs and white gloves, bouncing to the beat on flickering film. stick-figures: Stick people act the idea out on notebook paper: simple characters, big feelings, quick sketches around them. swiss-poster: A strict grid and one signal colour: big neutral type, hard edges and blocks that snap into place on the beat. watercolour: A nature journal that paints itself: soft washes bloom on cotton paper, ink lines draw in, and notes are written in the margins. whiteboard: Explainers drawn live in marker: the pen writes headings, sketches each idea as it's spoken and joins them with arrows."
    },
    "font": {
      "description": "The film's fonts, as a pairing chosen to suit each other. grotesk: Modern and confident. Tech, data and product stories. editorial: A magazine serif. Considered, classic and calm. condensed: Tall and narrow, like a news headline. Fits long titles. bold: Heavy, poster-like headings with a clean body. technical: Precise and engineered. Plans, systems and specs. friendly: Soft and rounded. Warm explainers for everyone. handwritten: Written by hand, like a whiteboard or a notebook. mono: Typewriter and terminal. Best with short headings. swiss: Neutral and exact, like a Swiss poster. Events, posters and grids. chalk: Chalk on a blackboard: sketched headings and neat classroom handwriting. pixel: A 90s video game: blocky pixel headings and screen-text body. terminal: An old green-screen monitor. Logs, systems and hacker stories. Defaults to the style's choice.",
      "type": "string",
      "enum": [
        "grotesk",
        "editorial",
        "condensed",
        "bold",
        "technical",
        "friendly",
        "handwritten",
        "mono",
        "swiss",
        "pixel",
        "terminal",
        "chalk"
      ]
    },
    "format": {
      "default": {},
      "type": "object",
      "properties": {
        "preset": {
          "description": "The platform the film is for. Sets the shape and keeps text clear of that app's buttons and captions.",
          "type": "string",
          "enum": [
            "tiktok",
            "reels",
            "shorts",
            "instagram",
            "linkedin-mobile",
            "linkedin-desktop",
            "linkedin-square",
            "x",
            "whatsapp",
            "youtube"
          ]
        },
        "aspect": {
          "description": "The shape of the frame. Set by the preset if there is one, otherwise 16:9.",
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "4:5",
            "1:1"
          ]
        },
        "resolution": {
          "description": "Set by the preset if there is one, otherwise 1080p.",
          "type": "string",
          "enum": [
            "720p",
            "1080p",
            "4k"
          ]
        },
        "fps": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        }
      }
    },
    "voice": {
      "default": {},
      "type": "object",
      "properties": {
        "engine": {
          "default": "kokoro",
          "type": "string",
          "enum": [
            "kokoro",
            "piper",
            "none"
          ]
        },
        "gender": {
          "default": "female",
          "description": "A female or male voice. Picks the best-sounding voice of that kind.",
          "type": "string",
          "enum": [
            "female",
            "male"
          ]
        },
        "voice": {
          "description": "A specific voice name for the engine, e.g. \"bf_emma\". Overrides gender.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "music": {
      "default": {},
      "type": "object",
      "properties": {
        "source": {
          "default": "generated",
          "description": "Music composed for the film, your own track, or none.",
          "type": "string",
          "enum": [
            "generated",
            "file",
            "none"
          ]
        },
        "file": {
          "description": "Path to your own track, relative to the film file. Used when source is \"file\".",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "mood": {
          "default": "calm",
          "description": "calm: gentle piano. upbeat: bright and positive. dramatic: tense and building. epic: big and cinematic. ambient: slow, spacious music over a nature sound. reflective: thoughtful piano. Each mood has a few pieces; one is picked from the title.",
          "type": "string",
          "enum": [
            "calm",
            "upbeat",
            "dramatic",
            "epic",
            "ambient",
            "reflective"
          ]
        },
        "track": {
          "description": "A specific piece of music, instead of one picked from the mood. \"composed\" is music written for the film.",
          "type": "string",
          "enum": [
            "composed",
            "lovely-piano-song",
            "study-and-relax",
            "city-sunshine",
            "the-drama",
            "driving-concern",
            "epic-blockbuster-2",
            "heroic-adventure",
            "infinite-wonder",
            "wisdom-in-the-sun",
            "nostalgic-piano",
            "romantic-inspiration"
          ]
        },
        "nature": {
          "description": "The nature sound under ambient music. Picked from the title if left out.",
          "type": "string",
          "enum": [
            "rain",
            "waves",
            "stream",
            "wind"
          ]
        },
        "volume": {
          "default": 0.2,
          "description": "How loud the music is between lines. It dips further while someone speaks.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sfx": {
      "default": {},
      "type": "object",
      "properties": {
        "volume": {
          "default": 0.5,
          "description": "How loud the sound effects are: whooshes between scenes, pops as things appear, ticks as numbers count. 0 turns them off.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "captions": {
      "default": true,
      "type": "boolean"
    },
    "motion": {
      "description": "How things move. calm: smooth and simple. lively: springy, headings appear word by word. punchy: bigger and bouncier, for short social films. Defaults to the style's choice.",
      "type": "string",
      "enum": [
        "calm",
        "lively",
        "punchy"
      ]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional name for the scene, handy for previews and error messages.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "narration": {
                "description": "What the voice says during this scene. Scene length is timed from this unless duration is set.",
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "duration": {
                "description": "Length in seconds. Overrides the timing worked out from narration.",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "transition": {
                "description": "How this scene enters. Defaults to the style's choice.",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe"
                ]
              },
              "motion": {
                "description": "How this scene moves, overriding the film's motion.",
                "type": "string",
                "enum": [
                  "calm",
                  "lively",
                  "punchy"
                ]
              },
              "type": {
                "type": "string",
                "const": "title"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "subtitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
