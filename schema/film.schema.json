{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec": {
      "type": "number",
      "const": 1,
      "description": "Version of the film spec format."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "style": {
      "type": "string",
      "enum": [
        "data-story",
        "product-launch",
        "whiteboard"
      ]
    },
    "format": {
      "default": {},
      "type": "object",
      "properties": {
        "preset": {
          "description": "The platform the film is for. Sets the shape and keeps text clear of that app's buttons and captions.",
          "type": "string",
          "enum": [
            "tiktok",
            "reels",
            "shorts",
            "instagram",
            "linkedin-mobile",
            "linkedin-desktop",
            "linkedin-square",
            "x",
            "whatsapp",
            "youtube"
          ]
        },
        "aspect": {
          "description": "The shape of the frame. Set by the preset if there is one, otherwise 16:9.",
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "4:5",
            "1:1"
          ]
        },
        "resolution": {
          "description": "Set by the preset if there is one, otherwise 1080p.",
          "type": "string",
          "enum": [
            "720p",
            "1080p",
            "4k"
          ]
        },
        "fps": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        }
      }
    },
    "voice": {
      "default": {},
      "type": "object",
      "properties": {
        "engine": {
          "default": "kokoro",
          "type": "string",
          "enum": [
            "kokoro",
            "piper",
            "none"
          ]
        },
        "gender": {
          "default": "female",
          "description": "A female or male voice. Picks the best-sounding voice of that kind.",
          "type": "string",
          "enum": [
            "female",
            "male"
          ]
        },
        "voice": {
          "description": "A specific voice name for the engine, e.g. \"bf_emma\". Overrides gender.",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "speed": {
          "default": 1,
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "music": {
      "default": {},
      "type": "object",
      "properties": {
        "source": {
          "default": "generated",
          "description": "Music composed for the film, your own track, or none.",
          "type": "string",
          "enum": [
            "generated",
            "file",
            "none"
          ]
        },
        "file": {
          "description": "Path to your own track, relative to the film file. Used when source is \"file\".",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "mood": {
          "default": "calm",
          "description": "calm: gentle piano. upbeat: bright and positive. dramatic: tense and building. epic: big and cinematic. ambient: slow, spacious music over a nature sound. reflective: thoughtful piano. Each mood has a few pieces; one is picked from the title.",
          "type": "string",
          "enum": [
            "calm",
            "upbeat",
            "dramatic",
            "epic",
            "ambient",
            "reflective"
          ]
        },
        "track": {
          "description": "A specific piece of music, instead of one picked from the mood. \"composed\" is music written for the film.",
          "type": "string",
          "enum": [
            "composed",
            "lovely-piano-song",
            "study-and-relax",
            "city-sunshine",
            "the-drama",
            "driving-concern",
            "epic-blockbuster-2",
            "heroic-adventure",
            "infinite-wonder",
            "wisdom-in-the-sun",
            "nostalgic-piano",
            "romantic-inspiration"
          ]
        },
        "nature": {
          "description": "The nature sound under ambient music. Picked from the title if left out.",
          "type": "string",
          "enum": [
            "rain",
            "waves",
            "stream",
            "wind"
          ]
        },
        "volume": {
          "default": 0.2,
          "description": "How loud the music is between lines. It dips further while someone speaks.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sfx": {
      "default": {},
      "type": "object",
      "properties": {
        "volume": {
          "default": 0.5,
          "description": "How loud the sound effects are: whooshes between scenes, pops as things appear, ticks as numbers count. 0 turns them off.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "captions": {
      "default": true,
      "type": "boolean"
    },
    "motion": {
      "description": "How things move. calm: smooth and simple. lively: springy, headings appear word by word. punchy: bigger and bouncier, for short social films. Defaults to the style's choice.",
      "type": "string",
      "enum": [
        "calm",
        "lively",
        "punchy"
      ]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional name for the scene, handy for previews and error messages.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "narration": {
                "description": "What the voice says during this scene. Scene length is timed from this unless duration is set.",
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "duration": {
                "description": "Length in seconds. Overrides the timing worked out from narration.",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "transition": {
                "description": "How this scene enters. Defaults to the style's choice.",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe"
                ]
              },
              "motion": {
                "description": "How this scene moves, overriding the film's motion.",
                "type": "string",
                "enum": [
                  "calm",
                  "lively",
                  "punchy"
                ]
              },
              "type": {
                "type": "string",
                "const": "title"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "subtitle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "title"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional name for the scene, handy for previews and error messages.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "narration": {
                "description": "What the voice says during this scene. Scene length is timed from this unless duration is set.",
                "type": "string",
