                "const": "custom"
              },
              "module": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Path to your own scene module, relative to the film file."
              },
              "props": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "type",
              "module"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "spec",
    "title",
    "style",
    "scenes"
  ],
  "$id": "https://github.com/ShazMoghaddam/bezel-film/blob/main/schema/film.schema.json",
  "title": "Bezel Film",
  "description": "One file that describes a whole film: settings plus a list of scenes."
}
