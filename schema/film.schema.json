              },
              "duration": {
                "description": "Length in seconds. Overrides the timing worked out from narration.",
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 120
              },
              "transition": {
                "description": "How this scene enters. Defaults to the style's choice.",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe"
                ]
              },
              "motion": {
                "description": "How this scene moves, overriding the film's motion.",
                "type": "string",
                "enum": [
                  "calm",
                  "lively",
                  "punchy"
                ]
              },
              "type": {
                "type": "string",
                "const": "stat"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                ],
                "description": "The big number, e.g. 42 or \"£1.2M\"."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "context": {
                "description": "A short line that gives the number meaning, e.g. \"up from 18 last year\".",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "value",
              "label"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "description": "Optional name for the scene, handy for previews and error messages.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
