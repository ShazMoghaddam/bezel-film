                  "type": {
                    "type": "string",
                    "enum": [
                      "bars",
                      "line",
                      "area",
                      "combo",
                      "waterfall",
                      "histogram",
                      "boxplot",
                      "scatter",
                      "ring",
                      "donut",
                      "gauge",
                      "progress",
                      "bullet",
                      "heatmap",
                      "spark"
                    ]
                  },
                  "heading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "values": {
                    "anyOf": [
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    ],
                    "description": "One list of numbers, or a list of lists for several series."
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "series": {
                    "description": "Series names, one per list in values.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "prefix": {
                    "type": "string",
                    "maxLength": 8
                  },
                  "suffix": {
                    "type": "string",
                    "maxLength": 12
                  },
                  "options": {
                    "description": "Any other Bezel Charts attribute, passed straight through, e.g. { \"goal\": 80 }.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "values"
                ]
              }
            },
            "required": [
              "type",
              "chart"
            ]
          },
