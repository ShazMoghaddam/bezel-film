{
  "name": "data-story",
  "label": "Data story",
  "description": "Clean, confident and chart-led. Big numbers, bold colour per series, calm motion.",
  "colours": {
    "background": "#0B1020",
    "surface": "#151B2E",
    "text": "#F5F7FB",
    "muted": "#9AA3B8",
    "accent": "#FFB020",
    "palette": ["#4C8DFF", "#FF5D73", "#2EC4B6", "#FFB020", "#9B5DE5", "#7BD389", "#FF8A3D"]
  },
  "fonts": {
    "heading": "Space Grotesk",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "motion": {
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "enterMs": 600,
    "staggerMs": 90,
    "transition": "fade",
    "transitionMs": 400
  },
  "layout": {
    "safeArea": 0.08,
    "captionPosition": "bottom"
  }
}
